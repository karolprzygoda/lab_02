generator client {
  provider = "prisma-client"
  output = "./generated"
}
datasource db {
  provider = "postgresql"
}
enum Channel {
  email
  push
}
enum Priority {
  high
  low
}
enum Status {
  pending
  sent
  failed
  cancelled
}
model Notification {
  id String @id @db.Uuid
  content String @db.VarChar(2000)
  recipient String @db.VarChar(254)
  channel Channel
  timezone String
  priority Priority
  scheduled_at DateTime @db.Timestamptz(3)
  available_at DateTime @db.Timestamptz(3)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  status Status @default(pending)
  attempts Int @default(0)
  simulate_failures Int @default(0)
  forced Boolean @default(false)
  sent_at DateTime? @db.Timestamptz(3)
  delivery Delivery?
  history Attempt[]
  @@index([channel, status, available_at])
  @@map("notifications")
}
model Delivery {
  notification_id String @id @db.Uuid
  notification Notification @relation(fields: [notification_id], references: [id])
  recipient String
  channel Channel
  content String
  delivered_at DateTime @db.Timestamptz(3)
  @@map("deliveries")
}
model Attempt {
  id Int @id @default(autoincrement())
  notification_id String @db.Uuid
  notification Notification @relation(fields: [notification_id], references: [id])
  number Int
  happened_at DateTime @db.Timestamptz(3)
  outcome String
  @@unique([notification_id, number])
  @@map("attempts")
}
model Worker {
  channel Channel @id
  heartbeat DateTime @db.Timestamptz(3)
  @@map("workers")
}
